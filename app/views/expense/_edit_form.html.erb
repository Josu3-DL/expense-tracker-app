
<%= form_with model: @expense, url: dashboard_path(@expense), method: :patch, local: false do |f| %>
  <div class="mb-3">
    <%= f.label :name, "Nombre", class: "form-label" %>
    <%= f.text_field :name, class: "form-control custom-input", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :ammount, "Cantidad", class: "form-label" %>
    <%= f.text_field :ammount, class: "form-control custom-input", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :category, "Categoría", class: "form-label" %>
    <%= f.select :category, ["Escuela", "Comida", "Transporte", "Entretenimiento", "Salud", "Otros"], {}, class: "form-select custom-input", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :date, "Fecha", class: "form-label" %>
    <%= f.date_field :date, class: "form-control custom-input", required: true %>
  </div>

  <div class="modal-footer border-0 justify-content-center">
    <button type="button" class="btn btn-outline-secondary cancel-btn" data-bs-dismiss="modal">Cancelar</button>
    <%= f.submit "Actualizar", class: "btn btn-primary save-btn" %>
  </div>
<% end %>